{
  "name": "jina-mcp-tools",
  "version": "1.2.5",
  "description": "Jina AI Model Context Protocol (MCP) server that integrates with Jina AI APIs for web reading and search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "jina-mcp-tools": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "verify": "pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "keywords": [
    "jina",
    "ai",
    "mcp",
    "model-context-protocol",
    "search",
    "web-reader",
    "cursor",
    "cursor-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PsychArch/jina-mcp-tools.git"
  },
  "homepage": "https://github.com/PsychArch/jina-mcp-tools#readme",
  "bugs": {
    "url": "https://github.com/PsychArch/jina-mcp-tools/issues"
  },
  "author": "PsychArch (https://github.com/PsychArch)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
